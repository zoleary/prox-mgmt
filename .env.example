# Copy to .env and fill in. Never commit .env.

# --- Web UI login (required) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
POLL_SECONDS=60

# --- Proxmox VE: Datacenter > Permissions > API Tokens ---
PVE_HOST=10.0.1.10
PVE_PORT=8006
PVE_TOKEN_ID=labpilot@pve!dashboard
PVE_TOKEN_SECRET=
PVE_VERIFY_SSL=false

# --- pfSense (pfSense-pkg-RESTAPI v2): System > REST API > Keys ---
PFSENSE_URL=https://10.0.1.1
PFSENSE_API_KEY=
PFSENSE_VERIFY_SSL=false

# --- Windows Server DHCP + DNS over WinRM ---
WINDOWS_HOST=10.0.1.5
WINDOWS_USER=LAB\svc-labpilot
WINDOWS_PASSWORD=
WINDOWS_TRANSPORT=ntlm
WINDOWS_USE_HTTPS=true
WINDOWS_VERIFY_SSL=false
DNS_ZONES=lab.home

# Subnets not covered by a DHCP scope or pfSense interface (optional)
# EXTRA_SUBNETS=Mgmt=10.0.1.0/24,Storage=10.0.50.0/24

# Memory overcommit thresholds (assigned RAM of running guests / physical RAM)
MEM_WARN_RATIO=1.2
MEM_CRIT_RATIO=1.5

# --- Chat assistant (console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# If the model declines a request, retry it on a fallback model server-side
CLAUDE_FALLBACKS=true
